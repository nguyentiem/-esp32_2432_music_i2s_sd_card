<screen>
  <view name="scr_idle_dash" width="320" height="240" scrollable="false">
    <style name="st_screen"/>

    <lv_obj name="hdr" x="0" y="0" width="320" height="28">
      <style name="st_transparent"/>
      <lv_label x="12" y="6" text="SYS://MONITOR" style_text_color="#c_cyan" style_text_font="lv_font_montserrat_12"/>
      <lv_label name="lbl_clock" align="top_right" x="-12" y="6" text="09:41:27" style_text_color="#c_cyan" style_text_font="lv_font_montserrat_12"/>
    </lv_obj>
    <lv_obj x="0" y="28" width="320" height="1" style_bg_color="#c_line" style_bg_opa="255" style_border_width="0"/>

    <lv_obj name="card_cpu" x="8" y="36" width="96" height="104">
      <style name="st_card"/>
      <lv_arc name="arc_cpu" align="top_mid" y="6" width="76" height="76"
              range_min="0" range_max="100" value="38" bg_start_angle="0" bg_end_angle="360"
              rotation="270" style_arc_width="7" style_arc_color="#c_cyan"
              style_arc_width:indicator="7" style_arc_color:indicator="#c_cyan"
              style_arc_color:main="#c_line" style_bg_opa:knob="0" style_pad_all:knob="0" clickable="false"/>
      <lv_label name="lbl_cpu_val" align="top_mid" y="32" text="38%" style_text_color="#c_cyan" style_text_font="lv_font_montserrat_16"/>
      <lv_label name="lbl_cpu_sub" align="bottom_mid" y="-6" text="CPU 240MHz" style_text_color="#c_dim" style_text_font="lv_font_montserrat_12"/>
    </lv_obj>

    <lv_obj name="card_ram" x="112" y="36" width="96" height="104">
      <style name="st_card"/>
      <lv_arc name="arc_ram" align="top_mid" y="6" width="76" height="76"
              range_min="0" range_max="100" value="44" bg_start_angle="0" bg_end_angle="360"
              rotation="270" style_arc_width="7" style_arc_color="#c_violet"
              style_arc_width:indicator="7" style_arc_color:indicator="#c_violet"
              style_arc_color:main="#c_line" style_bg_opa:knob="0" style_pad_all:knob="0" clickable="false"/>
      <lv_label name="lbl_ram_val" align="top_mid" y="32" text="44%" style_text_color="#c_violet" style_text_font="lv_font_montserrat_16"/>
      <lv_label name="lbl_ram_sub" align="bottom_mid" y="-6" text="RAM 142K" style_text_color="#c_dim" style_text_font="lv_font_montserrat_12"/>
    </lv_obj>

    <lv_obj name="col_stats" x="216" y="36" width="96" height="104">
      <style name="st_transparent"/>
      <lv_label x="0" y="0"  text="FLASH" style_text_color="#c_dim" style_text_font="lv_font_montserrat_12"/>
      <lv_label name="lbl_flash" align="top_right" y="0" text="30%" style_text_color="#c_amber" style_text_font="lv_font_montserrat_12"/>
      <lv_bar name="bar_flash" x="0" y="16" width="96" height="5" range_min="0" range_max="100" value="30"
              style_bg_color:main="#c_line" style_bg_color:indicator="#c_amber" style_radius="3"/>

      <lv_label x="0" y="36" text="TEMP" style_text_color="#c_dim" style_text_font="lv_font_montserrat_12"/>
      <lv_label name="lbl_temp" align="top_right" y="36" text="46°C" style_text_color="#c_orange" style_text_font="lv_font_montserrat_12"/>
      <lv_bar name="bar_temp" x="0" y="52" width="96" height="5" range_min="0" range_max="100" value="46"
              style_bg_color:main="#c_line" style_bg_color:indicator="#c_orange" style_radius="3"/>

      <lv_label x="0" y="72" text="RSSI" style_text_color="#c_dim" style_text_font="lv_font_montserrat_12"/>
      <lv_label name="lbl_rssi" align="top_right" y="72" text="-58dBm" style_text_color="#c_green" style_text_font="lv_font_montserrat_12"/>
      <lv_bar name="bar_rssi" x="0" y="88" width="96" height="5" range_min="0" range_max="100" value="72"
              style_bg_color:main="#c_line" style_bg_color:indicator="#c_green" style_radius="3"/>
    </lv_obj>

    <lv_obj name="card_chart" x="8" y="148" width="304" height="84">
      <style name="st_card"/>
      <lv_chart name="chart_sys" x="4" y="4" width="296" height="62" type="line"
                point_count="60" div_line_count="3,0" range_min="0" range_max="100"
                style_bg_opa="0" style_border_width="0" style_line_color="#c_line"
                style_line_width:items="2" style_size:indicator="0"/>
      <lv_label name="lbl_uptime" align="bottom_right" x="-8" y="-4" text="60s · uptime 03:12:45" style_text_color="#c_dim" style_text_font="lv_font_montserrat_12"/>
    </lv_obj>

    <lv_obj name="swipe_zone" align="bottom_mid" width="320" height="10" clickable="true">
      <style name="st_transparent"/>
    </lv_obj>
  </view>
</screen>
